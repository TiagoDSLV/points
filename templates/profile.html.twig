{# Onglet « Points » de la fiche Profile (GLPI 12 : pas de jeton CSRF). #}
{% import 'components/form/basic_inputs_macros.html.twig' as inputs %}

<div class="asset">
    {% if can_edit %}
        <form method="post" action="{{ form_url }}" data-track-changes="true">
            <input type="hidden" name="id" value="{{ item.getID() }}">
    {% endif %}
            <div class="card-body p-0">
                {% do item.displayRightsChoiceMatrix(rights, {
                    canedit: can_edit,
                    title: title
                }) %}
            </div>
    {% if can_edit %}
            <div class="card-body mx-n2 border-top d-flex flex-row-reverse align-items-start flex-wrap">
                {{ inputs.submit('update', _x('button', 'Save'), 1, {
                    class: 'btn btn-primary',
                    icon: 'ti ti-device-floppy'
                }) }}
            </div>
        </form>
    {% endif %}
</div>
